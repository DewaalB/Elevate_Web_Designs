# Copy to .dev.vars for local `npm run dev` only. .dev.vars is never deployed.
# Lets the dashboard at http://localhost:<port>/seo.html?dev=1 call the local
# worker without signing in. Has no effect on the deployed worker.
DEV_NO_AUTH=1
# ANTHROPIC_API_KEY=sk-ant-...
# Cloudflare's always-pass Turnstile test secret, for local testing of the public check
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
